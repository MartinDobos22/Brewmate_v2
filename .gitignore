# Dependencies
node_modules/
.pnpm-store/

# This workspace is pnpm's, and pnpm-lock.yaml is the only lockfile it has.
# A stray package-lock.json or yarn.lock - one npm command in the wrong
# directory - is enough to make EAS Build announce "we detected that 'frontend'
# is a npm workspace", run `npm ci` at the root, install the root's dev
# dependencies and nothing else, and then fail because the app has no `expo`.
package-lock.json
yarn.lock

# Build output
dist/
build/
*.tsbuildinfo

# Environment (never commit real secrets - only .env is tracked)
.env
.env.*
!.env.example

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Testing / coverage
coverage/
.vitest/

# Expo
.expo/
.expo-shared/
frontend/ios/
frontend/android/
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.orig.*
web-build/

# The Firebase client configuration files, generated per app in the Firebase
# console. Not secrets - the same values ship inside every APK and IPA - but on
# a public repository they hand a scraper the project id, the Android API key
# and the OAuth client ids without it having to unpack anything. A build gets
# them from EAS (GOOGLE_SERVICES_JSON as a file secret), so nothing here needs
# them checked in.
google-services.json
google-service.json
GoogleService-Info.plist

# Metro
.metro-health-check*

# JetBrains (WebStorm)
.idea/
*.iml

# Editors / OS
.vscode/
.DS_Store
Thumbs.db
