{
  "name": "@brewmate/server",
  "version": "0.1.0",
  "private": true,
  "description": "Brewmate API - Fastify + Drizzle + Firebase Admin",
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc --project tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate/migrateCli.ts",
    "db:seed": "tsx src/db/seed/seedCli.ts",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@brewmate/shared": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.12.1",
    "fastify-plugin": "^5.1.0",
    "fastify-type-provider-zod": "^7.0.0",
    "firebase-admin": "^14.3.0",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@fastify/swagger": "^9.5.1",
    "@types/node": "^22.19.0",
    "@types/pg": "^8.15.6",
    "drizzle-kit": "^0.31.10",
    "openapi-types": "^12.1.3",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
