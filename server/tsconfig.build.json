{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "rootDir": "./src",
    "outDir": "./dist",
    // Emit resolves @brewmate/shared through node_modules (the built package),
    // not through the source path alias used for editor navigation.
    "paths": {}
  },
  "include": ["src/**/*.ts"],
  "exclude": ["tests/**/*.ts"]
}
