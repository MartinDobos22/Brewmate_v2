# ---------------------------------------------------------------------------
# Brewmate API environment.
# Copy to .env and fill in. NEVER commit a filled-in .env.
# ---------------------------------------------------------------------------

NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=debug

# --- Database (hosted on Neon) ---------------------------------------------
# Development branch, pooled endpoint (hostname contains "-pooler").
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require

# Same branch, direct endpoint (no "-pooler"). Used by drizzle-kit and by
# `pnpm db:migrate`, which need a plain session connection.
# Optional: falls back to DATABASE_URL when unset.
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require

# Dedicated Neon branch for integration tests. Required when NODE_ENV=test.
# MUST NOT point at the development branch - the tests truncate every table.
TEST_DATABASE_URL=postgresql://USER:PASSWORD@ep-yyyy.REGION.aws.neon.tech/neondb?sslmode=require

# Maximum pooled connections held by the API process.
DATABASE_POOL_MAX=10

# --- Firebase Admin ---------------------------------------------------------
# From the service account JSON (Firebase console > Project settings >
# Service accounts > Generate new private key).
# Not required when NODE_ENV=test - integration tests use a stub verifier.
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
# Keep the surrounding quotes and the escaped newlines exactly as they appear
# in the JSON file.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"

# --- Model provider ---------------------------------------------------------
# Reads photographed coffee bag labels and writes the shop verdict. Every model
# call in Brewmate goes through this server, so the key lives here and never in
# the app - everything in an Expo bundle is readable by anyone who installs it.
# Optional: without it the app keeps working and the two /ai routes answer 503,
# which the scanner shows as "zadaj to ručne".
ANTHROPIC_API_KEY=
