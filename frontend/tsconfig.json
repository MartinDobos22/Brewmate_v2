{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "lib": [
      "ES2023",
      "DOM"
    ],
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowJs": true,
    "noEmit": true,
    "types": [
      "react"
    ]
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "app.config.ts"
  ]
}
