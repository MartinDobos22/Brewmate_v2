# ---------------------------------------------------------------------------
# Brewmate app environment.
# Only EXPO_PUBLIC_* variables reach the bundle - and everything in the bundle
# is readable by anyone who installs the app.
# NEVER put an API key, service account or database URL in this file.
# ---------------------------------------------------------------------------

# Base URL of the Brewmate API.
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000

# Firebase *client* configuration. These values are public by design; the
# Firebase Admin credentials live in /server/.env and never here.
# Firebase console > Project settings > General > Your apps > SDK setup.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Cloud Storage bucket photographed coffee bags are uploaded to, e.g.
# your-project.firebasestorage.app. Optional: leave it empty to ship a build
# without the camera - the scanner then asks for the label in the form, which
# has to work anyway for a shop with no signal.
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=

# --- Google Sign-In ---------------------------------------------------------
# OAuth client IDs, not secrets. Firebase console > Authentication > Sign-in
# method > Google creates the web client; the iOS and Android clients come from
# the Google Cloud console of the same project.
# Leave them empty to ship a build without the Google button - the app hides it
# instead of failing when it is pressed.
# The web client is also the fallback for platforms without their own ID.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=

# Sign in with Apple needs no client ID here: it is enabled in the Firebase
# console (Authentication > Sign-in method > Apple) and in the app's
# capabilities, which `expo-apple-authentication` adds through app.json.

# --- Error reporting --------------------------------------------------------
# A Sentry DSN, or the DSN of anything speaking the same envelope endpoint. A
# DSN is public by design - it identifies a project to receive reports and
# authorises nothing else - which is why it may live in the bundle at all.
# Optional: without it crashes are reported nowhere and the app works exactly
# as well. Only unexpected failures are sent, never a 404, a validation error
# or a request refused for being over the model allowance, and a report carries
# the error, the platform and a screen name - never a request body, an email or
# anything somebody typed about their coffee.
EXPO_PUBLIC_SENTRY_DSN=

# Which build a crash report belongs to. Set by the build pipeline (EAS fills
# it from the profile). Without it every report from every version is one
# undifferentiated pile and "did the fix work?" is unanswerable.
EXPO_PUBLIC_RELEASE=
